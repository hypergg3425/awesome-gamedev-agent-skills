class_name DoctrineSystem
extends RefCounted
## Military doctrines. Each country holds one land and one naval doctrine (state: country["doctrine"] =
## {"land": id, "naval": id, "since": {"land": turn, "naval": turn}}). A doctrine is unlocked by technology
## (and sometimes a minimum year), contributes national modifiers through Mods.country, costs gold to change,
## has a cool-down, and works at half strength while the army retrains after a switch.
## Data: data/doctrines.json (generated by tools/gen_data.py).

const SLOTS: Array[String] = ["land", "naval"]
const COOLDOWN_TURNS := 8      # minimum turns between two changes of the same slot
const RETRAIN_TURNS := 3       # turns at half effect after a change

static var _defs: Dictionary = {}

static func defs() -> Dictionary:
	if _defs.is_empty():
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/doctrines.json"))
		if parsed is Dictionary:
			_defs = parsed
	return _defs

static func get_def(did: String) -> Dictionary:
	return defs().get(did, {})

static func doctrine_name(did: String) -> String:
	return Loc.tx(get_def(did).get("name"))

static func ids_for_slot(slot: String) -> Array:
	var out: Array = []
	for did in defs():
		if str(defs()[did]["slot"]) == slot:
			out.append(did)
	out.sort()
	return out

static func is_unlocked(s: Dictionary, cid: String, did: String) -> bool:
	var d: Dictionary = get_def(did)
	var c: Dictionary = s["countries"].get(cid, {})
	if d.is_empty() or c.is_empty():
		return false
	for req in d["unlock"]:
		if TechSystem.level(c, str(req[0])) < int(req[1]):
			return false
	var ym: Variant = d.get("year_min")
	if ym != null and int(GS.date_of(s)["year"]) < int(ym):
		return false
	return true

static func available(s: Dictionary, cid: String, slot: String) -> Array:
	var out: Array = []
	for did in ids_for_slot(slot):
		if is_unlocked(s, cid, did):
			out.append(did)
	return out

static func current(c: Dictionary, slot: String) -> String:
	return str(c.get("doctrine", {}).get(slot, ""))

## Create the doctrine record (and a sensible starting doctrine) when missing.
static func ensure(s: Dictionary, cid: String) -> void:
	var c: Dictionary = s["countries"].get(cid, {})
	if c.is_empty() or cid == "REB":
		return
	if not (c.get("doctrine") is Dictionary):
		c["doctrine"] = {"land": "", "naval": "", "since": {"land": -99, "naval": -99}}
	var dd: Dictionary = c["doctrine"]
	if not (dd.get("since") is Dictionary):
		dd["since"] = {"land": -99, "naval": -99}
	for slot in SLOTS:
		var cur := str(dd.get(slot, ""))
		if cur == "" or not defs().has(cur) or not is_unlocked(s, cid, cur):
			dd[slot] = _default_for(s, cid, slot, cur)
			dd["since"][slot] = -99

static func _default_for(s: Dictionary, cid: String, slot: String, keep: String) -> String:
	var opts := available(s, cid, slot)
	if opts.is_empty():
		return ""
	var best := ""
	var bs := -1e9
	for did in opts:
		var sc := _generic_score(get_def(did)["mods"]) + float((get_def(did)["unlock"] as Array).size()) * 0.05
		if str(did) == keep:
			sc += 0.5
		if sc > bs:
			bs = sc
			best = str(did)
	return best

static func _generic_score(m: Dictionary) -> float:
	return float(m.get("inf_atk", 0.0)) + float(m.get("cav_atk", 0.0)) * 0.7 + float(m.get("art_atk", 0.0)) * 0.7 + float(m.get("morale", 0.0)) \
		+ float(m.get("discipline", 0.0)) + float(m.get("supply", 0.0)) * 0.4 + float(m.get("naval_atk", 0.0))

## Strength factor of a doctrine slot right now (retraining after a switch).
static func strength(s: Dictionary, c: Dictionary, slot: String) -> float:
	var since := int(c.get("doctrine", {}).get("since", {}).get(slot, -99))
	return 0.5 if int(s["turn"]) - since < RETRAIN_TURNS else 1.0

## National modifiers of the current doctrines (consumed by Mods.country).
static func mods_of(s: Dictionary, c: Dictionary) -> Dictionary:
	var out := {}
	if not (c.get("doctrine") is Dictionary):
		return out
	for slot in SLOTS:
		var did := current(c, slot)
		if did == "":
			continue
		var k := strength(s, c, slot)
		var m: Dictionary = get_def(did).get("mods", {})
		for key in m:
			out[key] = float(out.get(key, 0.0)) + float(m[key]) * k
	return out

static func switch_cost(s: Dictionary, cid: String, slot: String, to: String) -> Dictionary:
	var regs := UnitUtil.country_regiments(s, cid, slot == "naval")
	var f := float(get_def(to).get("switch_cost", 1.0))
	return {"gold": snappedf((40.0 + 7.0 * regs * (2.0 if slot == "naval" else 1.0)) * f, 1.0), "turns": RETRAIN_TURNS}

static func can_switch(s: Dictionary, cid: String, to: String) -> Dictionary:
	var d := get_def(to)
	if d.is_empty():
		return {"ok": false, "reason": "ERR_INVALID"}
	var c: Dictionary = s["countries"][cid]
	ensure(s, cid)
	var slot := str(d["slot"])
	if current(c, slot) == to:
		return {"ok": false, "reason": "DOC_ERR_SAME"}
	if not is_unlocked(s, cid, to):
		return {"ok": false, "reason": "DOC_ERR_LOCKED"}
	var since := int(c["doctrine"]["since"].get(slot, -99))
	if int(s["turn"]) - since < COOLDOWN_TURNS:
		return {"ok": false, "reason": "DOC_ERR_COOLDOWN", "params": {"n": COOLDOWN_TURNS - (int(s["turn"]) - since)}}
	var cost := switch_cost(s, cid, slot, to)
	if float(c["gold"]) < float(cost["gold"]):
		return {"ok": false, "reason": "ERR_NO_GOLD", "params": {"need": int(cost["gold"])}}
	return {"ok": true, "cost": cost, "slot": slot}

static func adopt(s: Dictionary, cid: String, to: String) -> Dictionary:
	var chk := can_switch(s, cid, to)
	if not chk["ok"]:
		return chk
	var c: Dictionary = s["countries"][cid]
	var slot: String = chk["slot"]
	c["gold"] = float(c["gold"]) - float(chk["cost"]["gold"])
	c["doctrine"][slot] = to
	c["doctrine"]["since"][slot] = int(s["turn"])
	# retraining: armies of that slot lose some drill while the new methods are taught
	for aid in GS.armies_of(s, cid):
		var a: Dictionary = s["armies"][aid]
		if bool(a.get("naval", false)) == (slot == "naval"):
			a["discipline"] = maxf(10.0, float(a.get("discipline", 50.0)) - 8.0)
	Mods.invalidate(s)
	GS.history(s, cid, "doctrine", "HIST_DOCTRINE", {"doctrine": to})
	return {"ok": true, "doctrine": to}

## --- AI -----------------------------------------------------------------------------------------------
## Score a doctrine for a country's actual army and personality.
static func ai_score(s: Dictionary, cid: String, did: String, pers: String) -> float:
	var m: Dictionary = get_def(did).get("mods", {})
	var shares := _composition_shares(s, cid)
	var off: float = {"aggressive": 1.4, "expansionist": 1.3, "opportunistic": 1.1, "defensive": 0.7, "isolationist": 0.6}.get(pers, 1.0)
	var dfn: float = {"defensive": 1.5, "isolationist": 1.4, "aggressive": 0.7}.get(pers, 1.0)
	var sc := 0.0
	sc += float(m.get("inf_atk", 0.0)) * (0.4 + shares["infantry"]) * off
	sc += float(m.get("cav_atk", 0.0)) * (0.2 + shares["cavalry"] * 1.5) * off
	sc += float(m.get("art_atk", 0.0)) * (0.2 + shares["artillery"] * 2.0) * off
	sc += float(m.get("inf_def", 0.0)) * dfn + float(m.get("fort_def", 0.0)) * dfn * 1.2
	sc += float(m.get("discipline", 0.0)) * 1.2 + float(m.get("morale", 0.0)) + float(m.get("supply", 0.0)) * 0.5
	sc += float(m.get("attrition", 0.0)) * -0.4 + float(m.get("manpower", 0.0)) * 0.4 + float(m.get("move", 0.0)) * 0.3 * off
	sc += float(m.get("siege", 0.0)) * 0.3 * off
	var navy := float(shares.get("navy", 0.0))
	var trade: float = {"naval_trade": 1.6, "economic": 1.2}.get(pers, 0.8)
	sc += float(m.get("naval_atk", 0.0)) * (0.3 + navy) * off + float(m.get("blockade", 0.0)) * 0.4
	sc += float(m.get("convoy", 0.0)) * 0.6 * trade + float(m.get("raid", 0.0)) * (0.5 if pers in ["aggressive", "opportunistic", "expansionist"] else 0.25)
	sc += float(m.get("naval_transport", 0.0)) * 0.3 + float(m.get("army_upkeep", 0.0)) * -0.3 + float(m.get("navy_upkeep", 0.0)) * -0.3
	return sc

static func _composition_shares(s: Dictionary, cid: String) -> Dictionary:
	var tot := 0.0
	var by := {"infantry": 0.0, "cavalry": 0.0, "artillery": 0.0}
	var navy := 0.0
	for aid in GS.armies_of(s, cid):
		var a: Dictionary = s["armies"][aid]
		if a.get("naval", false):
			navy += UnitUtil.army_size(a)
			continue
		for uid in a["units"]:
			var cls := str(Defs.units[uid]["cls"])
			var n := float(a["units"][uid])
			tot += n
			if cls in ["infantry", "heavy_infantry", "archers"]:
				by["infantry"] += n
			elif cls in ["cavalry", "heavy_cavalry"]:
				by["cavalry"] += n
			elif cls == "artillery":
				by["artillery"] += n
	var out := {"infantry": 0.5, "cavalry": 0.2, "artillery": 0.1, "navy": clampf(navy / 6.0, 0.0, 1.0)}
	if tot > 0.0:
		for k in by:
			out[k] = by[k] / tot
	return out

## AI: switch a slot when another doctrine is clearly better and affordable. Returns the doctrine adopted or "".
static func ai_review(s: Dictionary, cid: String, pers: String) -> String:
	ensure(s, cid)
	var c: Dictionary = s["countries"][cid]
	if int(s["turn"]) % 4 != int(cid.hash() % 4):
		return ""
	for slot in SLOTS:
		if slot == "naval" and UnitUtil.country_regiments(s, cid, true) < 1.0:
			continue
		var cur := current(c, slot)
		var cur_sc := ai_score(s, cid, cur, pers) if cur != "" else -1.0
		var best := ""
		var bs := cur_sc
		for did in available(s, cid, slot):
			if did == cur:
				continue
			var sc := ai_score(s, cid, did, pers)
			if sc > bs:
				bs = sc
				best = did
		if best == "" or bs < cur_sc * 1.2 + 0.03:
			continue
		var chk := can_switch(s, cid, best)
		if chk["ok"] and float(c["gold"]) > float(chk["cost"]["gold"]) * 3.0 + 50.0:
			adopt(s, cid, best)
			return best
	return ""
