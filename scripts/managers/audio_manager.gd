extends Node
## Audio (autoload "Audio"): music with cross-fade, pooled SFX, separate Music / SFX buses, global mute.
## All audio files are original, generated by tools/assets/gen_audio.py.

const SFX_VOICES := 8
var _music_a: AudioStreamPlayer
var _music_b: AudioStreamPlayer
var _active_a := true
var _voices: Array[AudioStreamPlayer] = []
var _cache := {}
var current_music := ""
var _tween: Tween

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_ensure_buses()
	_music_a = _make_player("Music")
	_music_b = _make_player("Music")
	for i in SFX_VOICES:
		_voices.append(_make_player("SFX"))
	Settings.changed.connect(func(k: String) -> void:
		if k in ["music_volume", "sfx_volume", "muted"]:
			apply_volumes())
	apply_volumes()

func _ensure_buses() -> void:
	for n in ["Music", "SFX"]:
		if AudioServer.get_bus_index(n) < 0:
			AudioServer.add_bus()
			var i := AudioServer.get_bus_count() - 1
			AudioServer.set_bus_name(i, n)
			AudioServer.set_bus_send(i, "Master")

func _make_player(bus: String) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus = bus
	add_child(p)
	return p

func apply_volumes() -> void:
	var muted := bool(Settings.get_value("muted"))
	AudioServer.set_bus_mute(AudioServer.get_bus_index("Master"), muted)
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("Music"), _db(float(Settings.get_value("music_volume"))))
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index("SFX"), _db(float(Settings.get_value("sfx_volume"))))

static func _db(v: float) -> float:
	return -80.0 if v <= 0.001 else linear_to_db(v)

## Release every stream reference at shutdown so the engine exits without leaked playbacks / resources.
func _exit_tree() -> void:
	if _tween != null and _tween.is_valid():
		_tween.kill()
	for p in [_music_a, _music_b] + _voices:
		if p != null and is_instance_valid(p):
			p.stop()
			p.stream = null
	_cache.clear()

func _stream(name: String, loop: bool) -> AudioStream:
	var key := "%s|%s" % [name, loop]
	if _cache.has(key):
		return _cache[key]
	var path := "res://assets/audio/%s.ogg" % name
	var s: AudioStream = null
	if ResourceLoader.exists(path):
		s = load(path)
		if s is AudioStreamOggVorbis:
			(s as AudioStreamOggVorbis).loop = loop
	_cache[key] = s
	return s

func sfx(name: String, volume_db: float = 0.0) -> void:
	var s := _stream(name, false)
	if s == null:
		return
	for v in _voices:
		if not v.playing:
			v.stream = s
			v.volume_db = volume_db
			v.play()
			return
	_voices[0].stream = s
	_voices[0].play()

func play_music(name: String, fade: float = 1.5) -> void:
	if name == current_music:
		return
	current_music = name
	var s := _stream(name, true)
	if s == null:
		return
	var next := _music_b if _active_a else _music_a
	var prev := _music_a if _active_a else _music_b
	_active_a = not _active_a
	next.stream = s
	next.volume_db = -60.0
	next.play()
	if _tween:
		_tween.kill()
	_tween = create_tween().set_parallel(true)
	_tween.tween_property(next, "volume_db", 0.0, fade)
	_tween.tween_property(prev, "volume_db", -60.0, fade)
	_tween.chain().tween_callback(prev.stop)

func stop_music(fade: float = 1.0) -> void:
	current_music = ""
	for p in [_music_a, _music_b]:
		if p.playing:
			var tw := create_tween()
			tw.tween_property(p, "volume_db", -60.0, fade)
			tw.tween_callback(p.stop)

func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_PAUSED or what == NOTIFICATION_WM_WINDOW_FOCUS_OUT:
		AudioServer.set_bus_mute(AudioServer.get_bus_index("Master"), true)
	elif what == NOTIFICATION_APPLICATION_RESUMED or what == NOTIFICATION_WM_WINDOW_FOCUS_IN:
		apply_volumes()
